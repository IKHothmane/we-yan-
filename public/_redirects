# =========================================================
#  We Yan Digital · Cloudflare Pages (et Netlify compatible)
#  ——————————————————————————————————————————————————————————
#  IMPORTANT RÈGLE CLOUDFLARE PAGES:
#  Les règles sont lues DE HAUT EN BAS · LA PREMIÈRE QUI MATCH = C'EST ELLE !
#  → On MET TOUJOURS LES EXCLUSIONS D'ASSETS EN PREMIER.
# =========================================================

# ——————————————————————————————————————————————————————————
# 1)  ASSETS BUILD VITE (hashés, /assets/*.js / .css / .woff2 etc.)
#    :splat signifie : sert le fichier S/IL EXISTE.
#    404 signifie : SI LE FICHIER N'EXISTE PAS → VRAI HTTP 404.
#    CECI ÉVITE QUE LA WILDCARD SPA `* → index.html` NE SERVE DU
#    HTML text/html POUR UN FICHIER JS/CSS MANQUANT → crash MIME.
# ——————————————————————————————————————————————————————————
/assets/*   :splat    404

# ——————————————————————————————————————————————————————————
# 2)  IMAGES / MEDIAS / FAVICON (statiques, racine / ou /public)
# ——————————————————————————————————————————————————————————
/*.webp      :splat    404
/*.png       :splat    404
/*.jpg       :splat    404
/*.jpeg      :splat    404
/*.svg       :splat    404
/*.ico       :splat    404
/favicon.ico :splat    404

# ——————————————————————————————————————————————————————————
# 3)  FICHIERS RACINE NON-HTML : SITEMAP.XML / ROBOTS.TXT
#     Règle 200 explicite (les exclut explicitement du fallback SPA)
# ——————————————————————————————————————————————————————————
/sitemap.xml         200
/sitemap.xml.gz      200
/robots.txt          200

# ——————————————————————————————————————————————————————————
# 3b)  ANCIENS SLUGS / LIENS MORTS → 301 (GSC Introuvable)
#      Avant le fallback SPA, sinon Google garde un 404.
# ——————————————————————————————————————————————————————————
/creation-site-web-casablanca                      /contact/ 301
/creation-site-web-casablanca/                     /contact/ 301
/seo                                               /services/seo/ 301
/seo/                                              /services/seo/ 301
/agence-seo                                        /agence-seo-casablanca/ 301
/agence-seo/                                       /agence-seo-casablanca/ 301
/about                                             /agence/ 301
/about/                                            /agence/ 301
/projects                                          /projets/ 301
/projects/                                         /projets/ 301
/blog                                              /blog/prix-seo-casablanca-2026/ 301
/blog/                                             /blog/prix-seo-casablanca-2026/ 301
/services/creation-contenu                         /services/creation-contenu-community-management/ 301
/services/creation-contenu/                        /services/creation-contenu-community-management/ 301
/services/community-management                     /community-management-casablanca/ 301
/services/community-management/                    /community-management-casablanca/ 301

# ——————————————————————————————————————————————————————————
# 4)  META-FICHIERS CLOUDFLARE PAGES / _headers / _redirects
#     (on les laisse passer en 200; ils ne sont pas servis aux utilisateurs
#      mais Cloudflare les lit à l'inclusion)
# ——————————————————————————————————————————————————————————
/_headers           200
/_redirects         200
/404.html           404

# 4b) API Pages Functions : ne pas renvoyer /api/* vers index.html
/api/*              /api/:splat     200

# ——————————————————————————————————————————————————————————
# 5)  SPAs REACT ROUTER : TOUTES LES AUTRES URLS
#     → page index.html  ·  code HTTP 200
#     Mettre CETTE RÈGLE EN TOUT DERNIER (sinon elle prend le dessus)
# ——————————————————————————————————————————————————————————
/*          /index.html     200
