# ——————————————————————————————————————————————————————————
# 1)  ASSETS BUILD VITE (hashés, /assets/*.js / .css / .woff2 etc.)
#    :splat signifie : sert le fichier S/IL EXISTE.
#    404 signifie : SI LE FICHIER N'EXISTE PAS → VRAI HTTP 404.
#    CECI ÉVITE QUE LA WILDCARD SPA `* → index.html` NE SERVE DU
#    HTML text/html POUR UN FICHIER JS/CSS MANQUANT → crash MIME.
# ——————————————————————————————————————————————————————————
/assets/*   :splat    404

# ——————————————————————————————————————————————————————————
# 2)  IMAGES / MEDIAS / FAVICON (statiques, racine / ou /public)
# ——————————————————————————————————————————————————————————
/*.webp      :splat    404
/*.png       :splat    404
/*.jpg       :splat    404
/*.jpeg      :splat    404
/*.svg       :splat    404
/*.ico       :splat    404
/favicon.ico :splat    404

# ——————————————————————————————————————————————————————————
# 3)  FICHIERS RACINE NON-HTML : SITEMAP.XML / ROBOTS.TXT
#     Règle 200 explicite (les exclut explicitement du fallback SPA)
# ——————————————————————————————————————————————————————————
/sitemap.xml         200
/sitemap.xml.gz      200
/robots.txt          200

