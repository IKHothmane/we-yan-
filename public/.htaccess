# We Yan Digital · React SPA (OVH Apache)
# Toutes les routes (/mentions-legales, /services/seo, etc.) doivent
# servir index.html en HTTP 200 pour que React Router fonctionne.

<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteBase /

  # Fichiers et dossiers existants : servir normalement
  RewriteCond %{REQUEST_FILENAME} -f [OR]
  RewriteCond %{REQUEST_FILENAME} -d
  RewriteRule ^ - [L]

  # Assets Vite manquants → vrai 404 (évite HTML servi comme JS/CSS)
  RewriteCond %{REQUEST_URI} ^/assets/ [NC]
  RewriteRule ^ - [R=404,L]

  # Autres fichiers statiques manquants (.js, .css, images…) → vrai 404
  RewriteCond %{REQUEST_URI} \.(js|mjs|css|webp|png|jpe?g|svg|ico|woff2?|map|xml|txt)$ [NC]
  RewriteRule ^ - [R=404,L]

  # Fallback SPA : toute autre URL → index.html (200)
  RewriteRule ^ index.html [L]
</IfModule>

Options -Indexes -MultiViews
