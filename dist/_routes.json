{
  "version": 1,
  "description": "We Yan Digital · Cloudflare Pages SPA. Réécrit les routes HTML VERS index.html, JAMAIS /assets/ ni fichiers statiques.",
  "include": ["/*"],
  "routes": [
    {
      "pathPattern": "/assets/*",
      "status": "passthrough"
    },
    {
      "pathPattern": "/*.webp",
      "status": "passthrough"
    },
    {
      "pathPattern": "/*.png",
      "status": "passthrough"
    },
    {
      "pathPattern": "/*.jpg",
      "status": "passthrough"
    },
    {
      "pathPattern": "/*.jpeg",
      "status": "passthrough"
    },
    {
      "pathPattern": "/*.svg",
      "status": "passthrough"
    },
    {
      "pathPattern": "/*.ico",
      "status": "passthrough"
    },
    {
      "pathPattern": "/sitemap.xml",
      "status": "passthrough"
    },
    {
      "pathPattern": "/robots.txt",
      "status": "passthrough"
    },
    {
      "pathPattern": "/_headers",
      "status": "passthrough"
    },
    {
      "pathPattern": "/_redirects",
      "status": "passthrough"
    },
    {
      "pathPattern": "/404.html",
      "status": "passthrough"
    },
    {
      "pathPattern": "/favicon.ico",
      "status": "passthrough"
    },
    {
      "pathPattern": "/*",
      "target": "/index.html"
    }
  ]
}
