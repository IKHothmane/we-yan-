# Copier vers .env.local pour le développement (ne jamais committer .env*)
# Cloudflare Pages → Settings → Environment variables (Production)

# Resend — envoi des e-mails de contact
RESEND_API_KEY=re_xxxxxxxx

# Mot de passe page /demandes (header X-Admin-Key uniquement)
ADMIN_DEMANDES_KEY=change-me-long-random-secret

# Google Apps Script (optionnel si URL par défaut déjà déployée)
# GOOGLE_SHEET_URL=https://script.google.com/macros/s/XXXX/exec

# Dev only : autorise ADMIN_DEMANDES_KEY=dev en local (jamais en prod)
# ALLOW_DEV_ADMIN_KEY=true
